{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "dev",
			"detail": "Start the Next.js dev server on http://localhost:3000",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev"
			],
			"options": {
				"cwd": "${workspaceFolder}/portfolio"
			},
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "build",
			"detail": "Static export into portfolio/out",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"options": {
				"cwd": "${workspaceFolder}/portfolio"
			},
			"problemMatcher": [
				"$tsc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "lint",
			"detail": "Run ESLint",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"lint"
			],
			"options": {
				"cwd": "${workspaceFolder}/portfolio"
			},
			"problemMatcher": [
				"$eslint-stylish"
			],
			"group": "build"
		},
		{
			"label": "sync profile",
			"detail": "Refresh profile.json from the GitHub API (add -- --dry-run to preview)",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"sync"
			],
			"options": {
				"cwd": "${workspaceFolder}/portfolio"
			},
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "git status",
			"detail": "Show the working tree status",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"--short"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "commit and push",
			"detail": "Stage all changes, commit and push to origin main",
			"type": "shell",
			"command": "git",
			"args": [
				"commit",
				"-am",
				"chore: update portfolio content",
				"&&",
				"git",
				"push",
				"origin",
				"main"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "commit tasks.json",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"commit-tasks.ps1"
			],
			"group": "build"
		},
		{
			"label": "final cleanup",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"cleanup-tasks.ps1"
			],
			"group": "build"
		},
		{
			"label": "rollback cleanup",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"rollback-cleanup.ps1"
			],
			"group": "build"
		}
	]
}